nt\n    participant S as Server\n    C->>S: initialize request\n    S-->>C: capabilities and version\n    C->>S: initialized notification\n    C->>S: tools/list\n    S-->>C: tool definitions\n    C->>S: tools/call\n    S-->>C: result content", "type": "sequencediagram", "nodes": {"C": "Client", "S": "Server"}, "labels": ["initialize request", "capabilities and version", "initialized notification", "tools/list", "tool definitions", "tools/call", "result content"], "order": ["C", "S"]}, "says": [{"id": "overview.1.2", "status": "ready", "text": "The client is the app hosting the model. The server owns the tools. Messages travel as JSON-RPC over standard input and output, or over HTTP.", "cues": [{"at": 4, "end": 10, "label": "client", "target": "", "inferred": true, "kind": "node", "id": "C", "text": "Client", "t": 0.35}, {"at": 45, "end": 51, "label": "server", "target": "", "inferred": true, "kind": "node", "id": "S", "text": "Server", "t": 2.837}], "notes": [], "code": [], "audio": "audio/86387f43c8e7cc50da429aa1.mp3", "duration": 11.225, "words": [{"s": 0.25, "e": 0.35, "c0": 0, "c1": 3}, {"s": 0.35, "e": 0.8, "c0": 4, "c1": 10}, {"s": 0.8, "e": 0.912, "c0": 11, "c1": 13}, {"s": 0.912, "e": 1.062, "c0": 14, "c1": 17}, {"s": 1.062, "e": 1.325, "c0": 18, "c1": 21}, {"s": 1.325, "e": 1.712, "c0": 22, "c1": 29}, {"s": 1.712, "e": 1.8, "c0": 30, "c1": 33}, {"s": 1.8, "e": 2.55, "c0": 34, "c1": 39}, {"s": 2.688, "e": 2.837, "c0": 41, "c1": 44}, {"s": 2.837, "e": 3.263, "c0": 45, "c1": 51}, {"s": 3.263, "e": 3.6, "c0": 52, "c1": 56}, {"s": 3.6, "e": 3.712, "c0": 57, "c1": 60}, {"s": 3.712, "e": 4.575, "c0": 61, "c1": 66}, {"s": 4.713, "e": 5.287, "c0": 68, "c1": 76}, {"s": 5.287, "e": 5.737, "c0": 77, "c1": 83}, {"s": 5.737, "e": 5.912, "c0": 84, "c1": 86}, {"s": 5.912, "e": 7.112, "c0": 87, "c1": 95}, {"s": 7.112, "e": 7.375, "c0": 96, "c1": 100}, {"s": 7.375, "e": 7.825, "c0": 101, "c1": 109}, {"s": 7.825, "e": 8.275, "c0": 110, "c1": 115}, {"s": 8.275, "e": 8.4, "c0":