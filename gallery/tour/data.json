 None:\n        \"\"\"Voice `spoken` unless cached; `done(result)` runs on the speech thread or immediately.\"\"\"\n        hit = self.cached(key)\n        if hit is not None:\n            self.stats[\"cache_hits\"] += 1\n            done(hit)\n            return\n        with self._lock:\n            if key in self._waiting:\n                self._waiting[key].append(done)\n                return\n            self._waiting[key] = [done]\n        self._q.put((priority, next(self._seq), _Job(key, spoken, voice, speed)))", "start": 92, "title": "narrator.py", "file": "src/showntell/speech/narrator.py"}, "says": [{"id": "one-queue-in-playing-order.1.1", "status": "ready", "text": "The narrator is one worker thread with a priority queue. A cached paragraph returns at once: the key is a hash of the model, voice, speed and spoken text, so nothing is voiced twice. Two sessions asking for the same audio share one job. Otherwise the job is queued by its position in the walkthrough, so earlier slides are always voiced first.", "cues": [{"at": 57, "end": 91, "label": "A cached paragraph returns at once", "target": "L94-98", "text": "", "kind": "lines", "side": "new", "l0": 94, "l1": 98, "t": 3.5}, {"at": 183, "end": 235, "label": "Two sessions asking for the same audio share one job", "target": "L100-102", "text": "", "kind": "lines", "side": "new", "l0": 100, "l1": 102, "t": 12.15}, {"at": 247, "end": 299, "label": "the job is queued by its position in the walkthrough", "target": "L104", "text": "", "kind": "lines", "side": "new", "l0": 104, "l1": 104, "t": 16.525}], "notes": [], "code": [], "audio": "audio/083d55f0702a67c2b4d5ba51.mp3", "duration": 22.175, "words": [{"s": 0.275, "e": 0.35, "c0": 0, "c1": 3}, {"s": 0.35, "e": 0.9, "c0": 4, "c1": 12}, {"s": 0.9, "e": 1.062, "c0": 13, "c1": 15}, {"s": 1.062, "e": 1.325, "c0": 16, "c1": 19}, {"s": 1.325, "e": 1.688, "c0": 20, "c1": 26}, {"s": 1.688, "e": 2.05, "c0": 27, "c1": 33}, {"s": 2.05, "e": 2.188, "c0": 34, "c1": 38}, {"s