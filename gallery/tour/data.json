      t += dur + gap;\n    });\n  });\n  return { segs, total: t };", "start": 19, "title": "timeline.js", "file": "src/showntell/static/js/timeline.js"}, "says": [{"id": "the-player-runs-on-one-clock.1.2", "status": "ready", "text": "In the browser, build lays every paragraph end to end on a single timeline. Voiced paragraphs use their real duration; unvoiced ones get an estimate from the word count. A segment is ready once its audio exists, and the player waits there if it catches up with the writer. Everything on screen, the slide, the pointer and the caption, is a pure function of that clock time.", "cues": [{"at": 76, "end": 117, "label": "Voiced paragraphs use their real duration", "target": "L29", "text": "", "kind": "lines", "side": "new", "l0": 29, "l1": 29, "t": 4.8}, {"at": 170, "end": 188, "label": "A segment is ready", "target": "L31", "text": "", "kind": "lines", "side": "new", "l0": 31, "l1": 31, "t": 10.45}], "notes": [], "code": [[16, 21]], "audio": "audio/739e6cd04ca7cb6a08501269.mp3", "duration": 22.95, "words": [{"s": 0.3, "e": 0.388, "c0": 0, "c1": 2}, {"s": 0.388, "e": 0.475, "c0": 3, "c1": 6}, {"s": 0.475, "e": 1.0, "c0": 7, "c1": 14}, {"s": 1.087, "e": 1.425, "c0": 16, "c1": 21}, {"s": 1.425, "e": 1.738, "c0": 22, "c1": 26}, {"s": 1.738, "e": 2.05, "c0": 27, "c1": 32}, {"s": 2.05, "e": 2.625, "c0": 33, "c1": 42}, {"s": 2.625, "e": 2.85, "c0": 43, "c1": 46}, {"s": 2.85, "e": 2.987, "c0": 47, "c1": 49}, {"s": 2.987, "e": 3.237, "c0": 50, "c1": 53}, {"s": 3.237, "e": 3.337, "c0": 54, "c1": 56}, {"s": 3.337, "e": 3.438, "c0": 57, "c1": 58}, {"s": 3.438, "e": 3.825, "c0": 59, "c1": 65}, {"s": 3.825, "e": 4.8, "c0": 66, "c1": 74}, {"s": 4.95, "e": 5.3, "c0": 76, "c1": 82}, {"s": 5.3, "e": 5.938, "c0": 83, "c1": 93}, {"s": 5.938, "e": 6.2, "c0": 94, "c1": 97}, {"s": 6.2, "e": 6.388, "c0": 98, "c1": 103}, {"s": 6.388, "e": 6.675, "c0": 104, "c1": 108}, {"s": 6.675, "e": 7.5, "c0": 109, "c1": 117}, {"s": 7.6, "e": 8.175, "c0": 119, "c1": 127}, {"s": 8