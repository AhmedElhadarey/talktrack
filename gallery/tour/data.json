re = q.get_nowait()\n                        ids |= more[\"slides\"]\n                        meta = meta or more[\"meta\"]\n                    yield f\"data: {json.dumps(s.delta(ids, meta))}\\n\\n\"\n            finally:\n                s.unsubscribe(q)", "start": 333, "title": "server.py", "file": "src/showntell/server.py"}, "says": [{"id": "changes-stream-to-the-browser.1.1", "status": "ready", "text": "The player opens a server sent event stream. It first gets the whole walkthrough. After that, bursts of changes are merged, and only the changed slides are sent. So a slide whose audio just finished arrives on its own.", "cues": [{"at": 45, "end": 80, "label": "It first gets the whole walkthrough", "target": "L336", "text": "", "kind": "lines", "side": "new", "l0": 336, "l1": 336, "t": 3.15}, {"at": 94, "end": 122, "label": "bursts of changes are merged", "target": "L343-347", "text": "", "kind": "lines", "side": "new", "l0": 343, "l1": 347, "t": 6.112}, {"at": 128, "end": 160, "label": "only the changed slides are sent", "target": "L348", "text": "", "kind": "lines", "side": "new", "l0": 348, "l1": 348, "t": 8.075}], "notes": [], "code": [], "audio": "audio/2a9d80beb9d3bef5ff40fdab.mp3", "duration": 14.0, "words": [{"s": 0.25, "e": 0.325, "c0": 0, "c1": 3}, {"s": 0.325, "e": 0.725, "c0": 4, "c1": 10}, {"s": 0.725, "e": 1.15, "c0": 11, "c1": 16}, {"s": 1.15, "e": 1.275, "c0": 17, "c1": 18}, {"s": 1.275, "e": 1.712, "c0": 19, "c1": 25}, {"s": 1.712, "e": 2.0, "c0": 26, "c1": 30}, {"s": 2.0, "e": 2.3, "c0": 31, "c1": 36}, {"s": 2.3, "e": 3.05, "c0": 37, "c1": 43}, {"s": 3.15, "e": 3.35, "c0": 45, "c1": 47}, {"s": 3.35, "e": 3.65, "c0": 48, "c1": 53}, {"s": 3.65, "e": 3.9, "c0": 54, "c1": 58}, {"s": 3.9, "e": 4.0, "c0": 59, "c1": 62}, {"s": 4.0, "e": 4.25, "c0": 63, "c1": 68}, {"s": 4.25, "e": 5.05, "c0": 69, "c1": 80}, {"s": 5.263, "e": 5.575, "c0": 82, "c1": 87}, {"s": 5.575, "e": 6.0, "c0": 88, "c1": 92}, {"s": 6.112, "e": 6.487, "c0": 94, "c1": 100}, {"s": 6.48