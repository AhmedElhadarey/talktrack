e": 1.137, "c0": 12, "c1": 17}]}]}, {"id": "daemon", "rev": 2, "kind": "code", "title": "Inside the daemon", "classes": [], "shown": "", "visual": {"lang": "python", "code": "    @mcp.custom_route(\"/api/rpc/{method}\", methods=[\"POST\"])\n    async def rpc(request: Request) -> Response:\n        auth = request.headers.get(\"authorization\", \"\")\n        if not secrets.compare_digest(auth, f\"Bearer {rpc_token}\"):\n            return JSONResponse({\"error\": \"forbidden\"}, status_code=403)\n        method = request.path_params[\"method\"]\n        if method == \"shutdown\":\n            asyncio.get_running_loop().call_later(0.2, stop or _shutdown)\n            return JSONResponse({\"result\": \"bye\"})\n        if method not in RPC_METHODS:\n            return JSONResponse({\"error\": \"unknown method\"}, status_code=404)\n        try:\n            kw = await request.json()\n            result = await getattr(service, method)(**kw)\n        except ValueError as e:\n            return JSONResponse({\"error\": str(e)}, status_code=400)\n        except TypeError as e:\n            return JSONResponse({\"error\": f\"bad arguments: {e}\"}, status_code=400)", "start": 472, "title": "server.py", "file": "src/showntell/server.py"}, "says": [{"id": "daemon.1.2", "status": "ready", "text": "The route compares the token in constant time, then checks the method name against an allow list.", "cues": [{"at": 0, "end": 9, "label": "The route", "target": "L472", "text": "/api/rpc/{method}", "kind": "lines", "side": "new", "l0": 472, "l1": 472, "t": 0.0}, {"at": 52, "end": 74, "label": "checks the method name", "target": "L481", "text": "if method not in RPC_METHODS", "kind": "lines", "side": "new", "l0": 481, "l1": 481, "t": 3.25}], "notes": [], "code": [], "audio": "audio/7e7f4ee51dc36c6bf2abaa48.mp3", "duration": 5.925, "words": [{"s": 0.275, "e": 0.388, "c0": 0, "c1": 3}, {"s": 0.388, "e": 0.7, "c0": 4, "c1": 9}, {"s": 0.7, "e": 1.113, "c0": 10, "c1": 18}, {"s": 1.113, "e":