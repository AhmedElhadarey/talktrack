": "br", "text": "Browser", "kind": "node", "id": "br", "t": 2.538}], "notes": [], "code": [], "audio": "audio/95982de8d52c5057ed2a5902.mp3", "duration": 3.625, "words": [{"s": 0.3, "e": 0.887, "c0": 0, "c1": 7}, {"s": 0.887, "e": 1.038, "c0": 8, "c1": 11}, {"s": 1.038, "e": 1.538, "c0": 12, "c1": 18}, {"s": 1.538, "e": 1.938, "c0": 19, "c1": 25}, {"s": 1.938, "e": 2.025, "c0": 26, "c1": 29}, {"s": 2.025, "e": 2.45, "c0": 30, "c1": 36}, {"s": 2.45, "e": 2.538, "c0": 37, "c1": 39}, {"s": 2.538, "e": 2.625, "c0": 40, "c1": 43}, {"s": 2.625, "e": 3.375, "c0": 44, "c1": 51}]}]}, {"id": "shim", "rev": 1, "kind": "code", "title": "Shim to daemon", "classes": [], "shown": "", "visual": {"lang": "python", "code": "class RemoteService:\n    \"\"\"Forwards calls to the daemon's `/api/rpc/{method}` route.\"\"\"\n\n    def __init__(self, base: str, token: str) -> None:\n        import httpx\n\n        self.base = base.rstrip(\"/\")\n        self.client = httpx.AsyncClient(timeout=httpx.Timeout(70.0, connect=5.0),\n                                        headers={\"Authorization\": f\"Bearer {token}\"})\n\n    async def _call(self, method: str, **kw) -> Any:\n        r = await self.client.post(f\"{self.base}/api/rpc/{method}\", json=kw)\n        data = r.json()\n        if r.status_code != 200:\n            raise ValueError(data.get(\"error\", f\"daemon error {r.status_code}\"))\n        return data[\"result\"]", "start": 153, "title": "service.py", "file": "src/showntell/service.py"}, "says": [{"id": "shim.1.1", "status": "ready", "text": "The agent's tool call lands in the shim, which looks for daemon.json in the data folder. If no daemon of the same version is healthy, it starts showntell serve and waits for /health.", "cues": [{"at": 57, "end": 63, "label": "daemon", "target": "", "inferred": true, "kind": "lines", "side": "new", "l0": 154, "l1": 154, "text": "daemon", "t": 3.525}], "notes": [], "code": [[57, 68], [144, 159], [174, 181]], "audio": "audio/7b386012edde831cb7f1