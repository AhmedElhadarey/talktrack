.25, "e": 23.775, "c0": 333, "c1": 337}]}]}, {"id": "when-the-guess-misses", "rev": 1, "kind": "diagram", "title": "When the guess misses", "classes": [], "shown": "", "visual": {"source": "sequenceDiagram\n    participant C as Client\n    participant S as Server\n    C->>S: ClientHello key_share X25519\n    S->>C: HelloRetryRequest wants P-256\n    C->>S: ClientHello key_share P-256\n    S->>C: ServerHello and encrypted flight", "type": "sequencediagram", "nodes": {"C": "Client", "S": "Server"}, "labels": ["ClientHello key_share X25519", "HelloRetryRequest wants P-256", "ClientHello key_share P-256", "ServerHello and encrypted flight"], "order": ["C", "S"]}, "says": [{"id": "when-the-guess-misses.1.1", "status": "ready", "text": "If the server doesn't support the client's guessed group, it replies with a HelloRetryRequest naming the group it wants. The client sends a second ClientHello and the handshake costs two round trips. That's the worst case, and it's rare.", "cues": [{"at": 76, "end": 93, "label": "HelloRetryRequest", "target": "", "text": "HelloRetryRequest", "kind": "text", "t": 3.975}, {"at": 140, "end": 158, "label": "second ClientHello", "target": "", "text": "key_share P-256", "kind": "text", "t": 7.938}], "notes": [], "code": [], "audio": "audio/55975b1214b64d10d1327e0f.mp3", "duration": 14.3, "words": [{"s": 0.25, "e": 0.4, "c0": 0, "c1": 2}, {"s": 0.4, "e": 0.537, "c0": 3, "c1": 6}, {"s": 0.537, "e": 0.925, "c0": 7, "c1": 13}, {"s": 0.925, "e": 1.25, "c0": 14, "c1": 21}, {"s": 1.25, "e": 1.637, "c0": 22, "c1": 29}, {"s": 1.637, "e": 1.725, "c0": 30, "c1": 33}, {"s": 1.725, "e": 2.15, "c0": 34, "c1": 42}, {"s": 2.15, "e": 2.4, "c0": 43, "c1": 50}, {"s": 2.4, "e": 2.925, "c0": 51, "c1": 56}, {"s": 3.038, "e": 3.175, "c0": 58, "c1": 60}, {"s": 3.175, "e": 3.775, "c0": 61, "c1": 68}, {"s": 3.775, "e": 3.913, "c0": 69, "c1": 73}, {"s": 3.913, "e": 3.975, "c0": 74, "c1": 75}, {"s": 3.975, "e": 5.287, "c0": 76, "c1": 93}, {"s": 5.287, "e": 5.662, "c0": 94,