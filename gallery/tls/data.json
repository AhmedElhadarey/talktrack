upported-groups", "title": "supported_groups", "body": "key exchange curves it can use, like X25519"}, {"id": "key-share", "title": "key_share", "body": "an ephemeral public key for its preferred group, sent right now"}, {"id": "sni-and-alpn", "title": "SNI and ALPN", "body": "which host name and which protocol, such as h2"}]}, "says": [{"id": "clienthello-the-client-guesses-ahead.1.2", "status": "ready", "text": "The ClientHello opens with a random value and a list of cipher suites. It names the groups it supports. The key move is the key share. Instead of asking which group the server wants, the client guesses, usually X25519, and sends an ephemeral public key immediately. Last come the host name and protocol.", "cues": [{"at": 29, "end": 35, "label": "random", "target": "random", "text": "", "kind": "item", "id": "random", "t": 1.637}, {"at": 56, "end": 69, "label": "cipher suites", "target": "cipher-suites", "text": "", "kind": "item", "id": "cipher-suites", "t": 3.112}, {"at": 84, "end": 90, "label": "groups", "target": "supported-groups", "text": "", "kind": "item", "id": "supported-groups", "t": 5.013}, {"at": 124, "end": 133, "label": "key share", "target": "key-share", "text": "", "kind": "item", "id": "key-share", "t": 7.562}, {"at": 280, "end": 302, "label": "host name and protocol", "target": "sni-and-alpn", "text": "", "kind": "item", "id": "sni-and-alpn", "t": 18.788}], "notes": [], "code": [], "audio": "audio/b4345a738f2d5882081c9808.mp3", "duration": 20.8, "words": [{"s": 0.275, "e": 0.35, "c0": 0, "c1": 3}, {"s": 0.35, "e": 0.963, "c0": 4, "c1": 15}, {"s": 0.963, "e": 1.413, "c0": 16, "c1": 21}, {"s": 1.413, "e": 1.538, "c0": 22, "c1": 26}, {"s": 1.538, "e": 1.637, "c0": 27, "c1": 28}, {"s": 1.637, "e": 2.05, "c0": 29, "c1": 35}, {"s": 2.05, "e": 2.587, "c0": 36, "c1": 41}, {"s": 2.587, "e": 2.712, "c0": 42, "c1": 45}, {"s": 2.712, "e": 2.775, "c0": 46, "c1": 47}, {"s": 2.775, "e": 2.987, "c0": 48, "c1": 52}, {"s": 2.987, "e": 3.112, "c0": 53, "c1":