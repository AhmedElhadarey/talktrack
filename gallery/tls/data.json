]}, {"id": "serverhello-the-guess-pays-off", "rev": 2, "kind": "list", "title": "ServerHello: the guess pays off", "classes": [], "shown": "", "visual": {"style": "bullets", "items": [{"id": "random", "title": "Random", "body": "the server's own 32 bytes"}, {"id": "chosen-suite", "title": "Chosen suite", "body": "one cipher suite from the client's list"}, {"id": "key-share", "title": "key_share", "body": "the server's ephemeral public key in the same group"}]}, "says": [{"id": "serverhello-the-guess-pays-off.1.2", "status": "ready", "text": "The server picks a suite and answers with its own key share. Now each side holds its private key and the other's public key, so both compute the same Diffie-Hellman secret. Everything the server sends after this point is encrypted.", "cues": [{"at": 19, "end": 24, "label": "suite", "target": "chosen-suite", "text": "", "kind": "item", "id": "chosen-suite", "t": 1.075}, {"at": 50, "end": 59, "label": "key share", "target": "key-share", "text": "", "kind": "item", "id": "key-share", "t": 2.9}], "notes": [], "code": [], "audio": "audio/ec527567ed10943aa3edf0d6.mp3", "duration": 14.55, "words": [{"s": 0.25, "e": 0.362, "c0": 0, "c1": 3}, {"s": 0.362, "e": 0.75, "c0": 4, "c1": 10}, {"s": 0.75, "e": 0.963, "c0": 11, "c1": 16}, {"s": 0.963, "e": 1.075, "c0": 17, "c1": 18}, {"s": 1.075, "e": 1.613, "c0": 19, "c1": 24}, {"s": 1.613, "e": 1.762, "c0": 25, "c1": 28}, {"s": 1.762, "e": 2.275, "c0": 29, "c1": 36}, {"s": 2.275, "e": 2.413, "c0": 37, "c1": 41}, {"s": 2.413, "e": 2.612, "c0": 42, "c1": 45}, {"s": 2.612, "e": 2.9, "c0": 46, "c1": 49}, {"s": 2.9, "e": 3.138, "c0": 50, "c1": 53}, {"s": 3.138, "e": 3.875, "c0": 54, "c1": 59}, {"s": 4.05, "e": 4.338, "c0": 61, "c1": 64}, {"s": 4.338, "e": 4.588, "c0": 65, "c1": 69}, {"s": 4.588, "e": 4.95, "c0": 70, "c1": 74}, {"s": 4.95, "e": 5.213, "c0": 75, "c1": 80}, {"s": 5.213, "e": 5.35, "c0": 81, "c1": 84}, {"s": 5.35, "e": 5.763, "c0": 85, "c1": 92}, {"s": 5.763, "e": 6.275, "c0": 93, "c1":