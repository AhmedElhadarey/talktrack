# showntell reads these when set. Command-line flags override them.
# None of them are secrets except SHOWNTELL_ACCESS_TOKEN.

# Interface and port the daemon binds.
SHOWNTELL_HOST=127.0.0.1
SHOWNTELL_PORT=4747

# Where walkthroughs, the audio cache and downloaded models are kept.
SHOWNTELL_DATA=~/.local/share/showntell

# Default voice: an English Kokoro voice id such as af_heart, am_michael or bf_emma.
SHOWNTELL_VOICE=af_heart

# Speech backend: auto (MLX on Apple silicon, ONNX elsewhere), mlx, onnx or fake.
SHOWNTELL_SPEECH=auto

# ONNX speech only: model variant (model_quantized by default; `model` is fp32) and CPU threads.
SHOWNTELL_ONNX_MODEL=
SHOWNTELL_THREADS=

# Base URL used in links, when the player is reached from another device. Links then carry an
# access token.
SHOWNTELL_PUBLIC_URL=

# Open each walkthrough in the browser as soon as it is playable (1 to enable).
SHOWNTELL_OPEN=

# Required when SHOWNTELL_HOST is not a loopback address. Generated if empty.
SHOWNTELL_ACCESS_TOKEN=

# Draw every slide headless when a walkthrough is finished, so layout problems reach the agent
# (needs Playwright; 0 to skip).
SHOWNTELL_FINISH_CHECK=1
